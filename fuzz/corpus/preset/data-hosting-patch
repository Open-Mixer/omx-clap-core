{
  "$schema": "../../schema/omx-contract.schema.json",
  "requires": {
    "omx-contract-schema": ">= 3.12.0"
  },
  "HOSTING_PATCH_CODES": {
    "kind": "codes",
    "since": "2.18.0",
    "doc": "The hosting codes of the patch dimension: hosting.patch.*, the verdict and refusal codes a qualifier, a host or the console write and read by code, never by prose (docs/data-layout.md).",
    "codes": {
      "patchBusy": {
        "code": "hosting.patch.busy",
        "text": {
          "en": "The plugin’s patch is busy right now. Try again once it’s free."
        }
      },
      "patchNotWritable": {
        "code": "hosting.patch.not-writable",
        "text": {
          "en": "This plugin’s patch cannot be written. Treat it as read-only."
        }
      },
      "patchTooLarge": {
        "code": "hosting.patch.too-large",
        "text": {
          "en": "This patch is too large for the plugin to accept. Use a smaller patch."
        }
      }
    }
  }
}
