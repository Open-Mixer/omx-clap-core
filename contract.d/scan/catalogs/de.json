    "SCAN_DOCUMENTS.CLAP_SCAN_DOCUMENT": {"text": "Das JSON-Dokument, das `omx-clap-scan` schreibt, ein Eintrag pro Datei mit seinen Plugins, seinen Parametern und seinen Ports.", "by": "machine", "model": "draft-prose", "source": "65f9a3403c591a56b3109924687c80722eeb8623049052f254f34319b600727e"},
    "SCAN_DOCUMENTS.FIELD_DUMP": {"text": "Der Feld-Dump, den `omx-clap-scan --fields` schreibt: eine Versionszeile, dann ein Scope-, Feld- und Wertdatensatz pro Feld, das ein Plugin angibt.", "by": "machine", "model": "draft-prose", "source": "9090693346d8fe443ac0968ed0beebbfc999e17be0c50721302e863b3feca394"},
    "SCAN_FIELD_SCOPES.audio_in": {"text": "Ein Audio-Eingangsport, indiziert.", "by": "machine", "model": "draft-prose", "source": "bf4b6fe71fa43a9960d6254f9b642b0b6ba9bfc50bc562eefbbd65ab703d1355"},
    "SCAN_FIELD_SCOPES.audio_out": {"text": "Ein Audio-Ausgangsport, indiziert.", "by": "machine", "model": "draft-prose", "source": "5069d9296e97a6318c2c1530d7380ad5997efab3d7b3669c6681fe254dc221a7"},
    "SCAN_FIELD_SCOPES.control": {"text": "Eine Steuerung der Panel-Beschreibung, indiziert.", "by": "machine", "model": "draft-prose", "source": "343d25f05ecc9b09137a4e3df619d5b9f6bbffc6fb0fe951af71f5853653c74e"},
    "SCAN_FIELD_SCOPES.display": {"text": "Eine Anzeige der Panel-Beschreibung, indiziert.", "by": "machine", "model": "draft-prose", "source": "fcfcdd9df06bfbdec27e293e0f50151a976b1663620ad44e2a580589e14d48e1"},
    "SCAN_FIELD_SCOPES.meter": {"text": "Ein Pegelmesser eines Plugins, das die Meters-Erweiterung bereitstellt, indiziert.", "by": "machine", "model": "draft-prose", "source": "ebe0950c884bcab453c556e3538f9de26847e37095fbce5023eeb9aaa42dc61a"},
    "SCAN_FIELD_SCOPES.note_in": {"text": "Ein Note-Eingangsport, indiziert.", "by": "machine", "model": "draft-prose", "source": "f0b1d11ab6791a331705f41fb0f84a2bcf5bc12a1c6c493f7f736073b2146c00"},
