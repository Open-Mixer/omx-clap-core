    "SCAN_FIELD_SCOPES.panel": {"text": "Die Panel-Beschreibung eines Plugins, das `org.openmixer.panel-description/1` bedient: seine Familie und sein Fingerabdruck.", "by": "machine", "model": "draft-prose", "source": "d6c60f413c791ccee86e232694bc71af000b23e7d9ee8e7393c1b92171ef4b42"},
    "SCAN_FIELD_SCOPES.param": {"text": "Ein CLAP-Parameter, indiziert in der Reihenfolge von get_info.", "by": "machine", "model": "draft-prose", "source": "ba2c39fb29d0a66723c3e14e2704ffecc797e2efcd37e5bd25375c2ac55d9d94"},
    "SCAN_FIELD_SCOPES.placement_default": {"text": "Ein pro-Platzierung Startwert der Panel-Beschreibung, indiziert.", "by": "machine", "model": "draft-prose", "source": "81ef7318bb803e0e8ede7fad7d6a18760d77088653d4e2a3dbd1152f23338676"},
    "SCAN_FIELD_SCOPES.plugin": {"text": "Das Plugin als Ganzes.", "by": "machine", "model": "draft-prose", "source": "30cf20290be6a57b2441caa13cd2a7407d320b42cb7886629da287327dad9cd7"},
    "SCAN_FIELD_SCOPES.port": {"text": "Ein LV2-Port, indiziert durch seine `lv2:index`.", "by": "machine", "model": "draft-prose", "source": "99c98d119215bdf68132852baf3e5edc837d59e99419a46bfef90a3437428e46"},
