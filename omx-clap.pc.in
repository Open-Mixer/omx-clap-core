prefix=@PREFIX@
libdir=@LIBDIR@
includedir=@INCLUDEDIR@
datadir=@DATADIR@
# the hosting items as TypeScript modules, omx-clap-hosting.js and omx-clap-vocabulary.js and their .d.ts
tsdir=${datadir}/omx-clap/ts

Name: omx-clap
Description: The CLAP hosting core of omx-clap-host: a plugin's process() on the caller's RT thread and the control thread that owns the plugin
Version: @VERSION@
Requires: clap
# hosted_stage.h takes its DSP words from omx-dsp's headers, which name omx-contract's; clap_host.h its hosting codes
# from omx_clap_vocabulary.h, installed beside it, and the resource hints from omx-contract's
# omxcontract/omx_resource_hints.h; nothing of either is linked. Named without a version: no floor (owner ruling 2026-11-24)
Requires.private: omxdsp, omx-contract, libcrypto
Libs: -L${libdir} -lomx-clap
Cflags: -I${includedir}
