# lv2_host_fixture.c's ports, its default state (−6 dB, only state:loadDefaultState delivers it),
# and the twins the host must refuse from this TTL alone, one per refusal code.
@prefix bufsz: <http://lv2plug.in/ns/ext/buf-size#> .
@prefix atom:  <http://lv2plug.in/ns/ext/atom#> .
@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix midi:  <http://lv2plug.in/ns/ext/midi#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rsz:   <http://lv2plug.in/ns/ext/resize-port#> .
@prefix state: <http://lv2plug.in/ns/ext/state#> .
@prefix urid:  <http://lv2plug.in/ns/ext/urid#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix fx:    <urn:openmixer:test:host-fixture#> .

fx:offset_db
    a rdf:Property ;
    rdfs:label "offset in dB" ;
    rdfs:range xsd:float .

<urn:openmixer:test:host-fixture>
    a lv2:Plugin , lv2:AmplifierPlugin ;
    doap:name "openmixer host fixture" ;
    doap:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
    lv2:requiredFeature urid:map , state:loadDefaultState ;
    lv2:extensionData state:interface ;
    state:state [
        fx:offset_db "-6.0"^^xsd:float
    ] ;
    lv2:port [
        a lv2:AudioPort , lv2:InputPort ; lv2:index 0 ; lv2:symbol "in" ; lv2:name "In"
    ] , [
        a lv2:AudioPort , lv2:OutputPort ; lv2:index 1 ; lv2:symbol "out" ; lv2:name "Out"
    ] , [
        a lv2:ControlPort , lv2:InputPort ; lv2:index 2 ; lv2:symbol "enabled" ; lv2:name "Enabled" ;
        lv2:designation lv2:enabled ; lv2:portProperty lv2:toggled ;
        lv2:default 1 ; lv2:minimum 0 ; lv2:maximum 1
    ] , [
        a lv2:ControlPort , lv2:InputPort ; lv2:index 3 ; lv2:symbol "gain_db" ; lv2:name "Gain" ;
        lv2:default -20.0 ; lv2:minimum -60.0 ; lv2:maximum 0.0
    ] , [
        a lv2:ControlPort , lv2:OutputPort ; lv2:index 4 ; lv2:symbol "meter" ; lv2:name "Meter"
    ] , [
        a lv2:ControlPort , lv2:OutputPort ; lv2:index 5 ; lv2:symbol "latency" ; lv2:name "Latency" ;
        lv2:designation lv2:latency ; lv2:portProperty lv2:reportsLatency , lv2:integer
    ] .

<urn:openmixer:test:host-fixture#atom>
    a lv2:Plugin ;
    doap:name "openmixer host fixture (atom value input twin)" ;
    lv2:port [
        a lv2:AudioPort , lv2:InputPort ; lv2:index 0 ; lv2:symbol "in" ; lv2:name "In"
    ] , [
        a lv2:AudioPort , lv2:OutputPort ; lv2:index 1 ; lv2:symbol "out" ; lv2:name "Out"
    ] , [
        a atom:AtomPort , lv2:InputPort ; atom:bufferType atom:Atom ;
        lv2:index 2 ; lv2:symbol "events" ; lv2:name "Events"
    ] .

<urn:openmixer:test:host-fixture#midi-two>
    a lv2:Plugin ;
    doap:name "openmixer host fixture (two MIDI inputs twin)" ;
    lv2:port [
        a lv2:AudioPort , lv2:InputPort ; lv2:index 0 ; lv2:symbol "in" ; lv2:name "In"
    ] , [
        a lv2:AudioPort , lv2:OutputPort ; lv2:index 1 ; lv2:symbol "out" ; lv2:name "Out"
    ] , [
        a atom:AtomPort , lv2:InputPort ; atom:bufferType atom:Sequence ; atom:supports midi:MidiEvent ;
        lv2:index 2 ; lv2:symbol "midi_a" ; lv2:name "MIDI A"
    ] , [
        a atom:AtomPort , lv2:InputPort ; atom:bufferType atom:Sequence ; atom:supports midi:MidiEvent ;
        lv2:index 3 ; lv2:symbol "midi_b" ; lv2:name "MIDI B"
    ] .

<urn:openmixer:test:host-fixture#wide>
    a lv2:Plugin ;
    doap:name "openmixer host fixture (mono-in stereo-out twin)" ;
    lv2:port [
        a lv2:AudioPort , lv2:InputPort ; lv2:index 0 ; lv2:symbol "in" ; lv2:name "In"
    ] , [
        a lv2:AudioPort , lv2:OutputPort ; lv2:index 1 ; lv2:symbol "out_l" ; lv2:name "Out L"
    ] , [
        a lv2:AudioPort , lv2:OutputPort ; lv2:index 2 ; lv2:symbol "out_r" ; lv2:name "Out R"
    ] .

<urn:openmixer:test:host-fixture#cv>
    a lv2:Plugin ;
    doap:name "openmixer host fixture (CV twin)" ;
    lv2:port [
        a lv2:AudioPort , lv2:InputPort ; lv2:index 0 ; lv2:symbol "in" ; lv2:name "in"
    ] , [
        a lv2:AudioPort , lv2:OutputPort ; lv2:index 1 ; lv2:symbol "out" ; lv2:name "out"
    ] , [
        a lv2:CVPort , lv2:InputPort ; lv2:index 2 ; lv2:symbol "mod" ; lv2:name "Mod"
    ] .

# the generator twin: a stereo output and no input of any kind (an oscillator's or a noise source's shape), admitted
# as a source; it writes 0.5 on the left and 0.25 on the right, the meter source's levels, so a graph hears it
<urn:openmixer:test:host-fixture#gen>
    a lv2:Plugin ;
    doap:name "openmixer host fixture (generator twin: no input, stereo out)" ;
    lv2:port [
        a lv2:AudioPort , lv2:OutputPort ; lv2:index 0 ; lv2:symbol "out_l" ; lv2:name "out_l"
    ] , [
        a lv2:AudioPort , lv2:OutputPort ; lv2:index 1 ; lv2:symbol "out_r" ; lv2:name "out_r"
    ] .

# control ports and nothing else: no audio port, no MIDI port either way; hosted as a pass-through tool (#253), its
# control output `twice` the input `amount` times two
<urn:openmixer:test:host-fixture#ctl-alone>
    a lv2:Plugin ;
    doap:name "openmixer host fixture (control ports alone twin)" ;
    lv2:port [
        a lv2:ControlPort , lv2:InputPort ; lv2:index 0 ; lv2:symbol "amount" ; lv2:name "amount" ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        a lv2:ControlPort , lv2:OutputPort ; lv2:index 1 ; lv2:symbol "twice" ; lv2:name "twice" ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 2.0
    ] .

# no port at all: nothing the host feeds or reads; refused from the TTL, hosting.topology.no-audio-output
<urn:openmixer:test:host-fixture#no-ports>
    a lv2:Plugin ;
    doap:name "openmixer host fixture (no port at all twin)" .

<urn:openmixer:test:host-fixture#no-out>
    a lv2:Plugin ;
    doap:name "openmixer host fixture (no audio output twin: an analyser)" ;
    lv2:port [
        a lv2:AudioPort , lv2:InputPort ; lv2:index 0 ; lv2:symbol "in" ; lv2:name "in"
    ] , [
        a lv2:ControlPort , lv2:OutputPort ; lv2:index 1 ; lv2:symbol "peak" ; lv2:name "peak" ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] .

# a MIDI sink: a MIDI input and control ports, no audio port and no MIDI output; hosted as a pass-through tool (#253),
# its control output `notes` the count of MIDI events read in the block
<urn:openmixer:test:host-fixture#ctl-only>
    a lv2:Plugin ;
    doap:name "openmixer host fixture (a MIDI sink twin: a MIDI input and control ports)" ;
    lv2:requiredFeature urid:map ;
    lv2:port [
        a atom:AtomPort , lv2:InputPort ; atom:bufferType atom:Sequence ; atom:supports midi:MidiEvent ;
        lv2:index 0 ; lv2:symbol "midi_in" ; lv2:name "midi_in"
    ] , [
        a lv2:ControlPort , lv2:InputPort ; lv2:index 1 ; lv2:symbol "amount" ; lv2:name "amount" ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        a lv2:ControlPort , lv2:OutputPort ; lv2:index 2 ; lv2:symbol "notes" ; lv2:name "notes" ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1024.0
    ] .

<urn:openmixer:test:host-fixture#three-in>
    a lv2:Plugin ;
    doap:name "openmixer host fixture (three inputs twin)" ;
    lv2:port [
        a lv2:AudioPort , lv2:InputPort ; lv2:index 0 ; lv2:symbol "in_a" ; lv2:name "in_a"
    ] , [
        a lv2:AudioPort , lv2:InputPort ; lv2:index 1 ; lv2:symbol "in_b" ; lv2:name "in_b"
    ] , [
        a lv2:AudioPort , lv2:InputPort ; lv2:index 2 ; lv2:symbol "in_c" ; lv2:name "in_c"
    ] , [
        a lv2:AudioPort , lv2:OutputPort ; lv2:index 3 ; lv2:symbol "out_a" ; lv2:name "out_a"
    ] , [
        a lv2:AudioPort , lv2:OutputPort ; lv2:index 4 ; lv2:symbol "out_b" ; lv2:name "out_b"
    ] .

<urn:openmixer:test:host-fixture#fixed>
    a lv2:Plugin ;
    doap:name "openmixer host fixture (fixed block length twin)" ;
    lv2:requiredFeature bufsz:fixedBlockLength ;
    lv2:port [
        a lv2:AudioPort , lv2:InputPort ; lv2:index 0 ; lv2:symbol "in" ; lv2:name "in"
    ] , [
        a lv2:AudioPort , lv2:OutputPort ; lv2:index 1 ; lv2:symbol "out" ; lv2:name "out"
    ] .

<urn:openmixer:test:host-fixture#inplace>
    a lv2:Plugin ;
    doap:name "openmixer host fixture (in-place broken twin)" ;
    lv2:requiredFeature lv2:inPlaceBroken ;
    lv2:port [
        a lv2:AudioPort , lv2:InputPort ; lv2:index 0 ; lv2:symbol "in" ; lv2:name "in"
    ] , [
        a lv2:AudioPort , lv2:OutputPort ; lv2:index 1 ; lv2:symbol "out" ; lv2:name "out"
    ] .

<urn:openmixer:test:host-fixture#mappath>
    a lv2:Plugin ;
    doap:name "openmixer host fixture (state mapPath twin)" ;
    lv2:requiredFeature state:mapPath ;
    lv2:port [
        a lv2:AudioPort , lv2:InputPort ; lv2:index 0 ; lv2:symbol "in" ; lv2:name "in"
    ] , [
        a lv2:AudioPort , lv2:OutputPort ; lv2:index 1 ; lv2:symbol "out" ; lv2:name "out"
    ] .

<urn:openmixer:test:host-fixture#makepath>
    a lv2:Plugin ;
    doap:name "openmixer host fixture (state makePath twin)" ;
    lv2:requiredFeature state:makePath ;
    lv2:port [
        a lv2:AudioPort , lv2:InputPort ; lv2:index 0 ; lv2:symbol "in" ; lv2:name "in"
    ] , [
        a lv2:AudioPort , lv2:OutputPort ; lv2:index 1 ; lv2:symbol "out" ; lv2:name "out"
    ] .

# the aux-only twin (#aux-only, omx-clap-core#3): the only output is lv2:isSideChain, so read_side's grouping finds
# no main output at all; the port must stay an auxiliary output, not be dropped by refusing the plugin for having
# none (hosting.no-audio-output), the same way a plugin with no audio output is hosted, the strip's audio untouched
<urn:openmixer:test:host-fixture#aux-only>
    a lv2:Plugin ;
    doap:name "openmixer host fixture (aux-only output twin: the only output is a side chain)" ;
    lv2:port [
        a lv2:AudioPort , lv2:InputPort ; lv2:index 0 ; lv2:symbol "in" ; lv2:name "in"
    ] , [
        a lv2:AudioPort , lv2:OutputPort ; lv2:index 1 ; lv2:symbol "tap" ; lv2:name "tap" ;
        lv2:portProperty lv2:isSideChain
    ] .

# the latency-only twin (#latency-only, omx-clap-core#3): the only control port is the one lv2:latency designates;
# it is read as p->latency_port and never counted among p->controls, so a plugin with nothing else is read as having
# no control at all, main audio only, and a latency port
<urn:openmixer:test:host-fixture#latency-only>
    a lv2:Plugin ;
    doap:name "openmixer host fixture (latency-only twin: no control but the latency port)" ;
    lv2:port [
        a lv2:AudioPort , lv2:InputPort ; lv2:index 0 ; lv2:symbol "in" ; lv2:name "in"
    ] , [
        a lv2:AudioPort , lv2:OutputPort ; lv2:index 1 ; lv2:symbol "out" ; lv2:name "out"
    ] , [
        a lv2:ControlPort , lv2:OutputPort ; lv2:index 2 ; lv2:symbol "latency" ; lv2:name "latency" ;
        lv2:designation lv2:latency ; lv2:portProperty lv2:reportsLatency , lv2:integer
    ] .

# the mixed twin (#mixed, omx-clap-core#3): a main pair, a CV input, a side-chain input outside the main group, a
# control input, the latency output and a plain MIDI input, every kind on one plugin, each read by its own type
# regardless of the others (read_ports no longer stops classifying a plugin's ports once one kind is read)
<urn:openmixer:test:host-fixture#mixed>
    a lv2:Plugin ;
    doap:name "openmixer host fixture (mixed shapes twin: main, CV, side chain, control, latency and MIDI together)" ;
    lv2:requiredFeature urid:map ;
    lv2:port [
        a lv2:AudioPort , lv2:InputPort ; lv2:index 0 ; lv2:symbol "in" ; lv2:name "in"
    ] , [
        a lv2:AudioPort , lv2:OutputPort ; lv2:index 1 ; lv2:symbol "out" ; lv2:name "out"
    ] , [
        a lv2:CVPort , lv2:InputPort ; lv2:index 2 ; lv2:symbol "cv_mod" ; lv2:name "cv_mod"
    ] , [
        a lv2:AudioPort , lv2:InputPort ; lv2:index 3 ; lv2:symbol "side" ; lv2:name "side" ;
        lv2:portProperty lv2:isSideChain
    ] , [
        a lv2:ControlPort , lv2:InputPort ; lv2:index 4 ; lv2:symbol "amount" ; lv2:name "amount" ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        a lv2:ControlPort , lv2:OutputPort ; lv2:index 5 ; lv2:symbol "latency" ; lv2:name "latency" ;
        lv2:designation lv2:latency ; lv2:portProperty lv2:reportsLatency , lv2:integer
    ] , [
        a atom:AtomPort , lv2:InputPort ; atom:bufferType atom:Sequence ; atom:supports midi:MidiEvent ;
        lv2:index 6 ; lv2:symbol "midi_in" ; lv2:name "midi_in"
    ] .

# the MIDI rsz twin (#midi-rsz, omx-clap-core#3): the plain (non-patch) MIDI input declares rsz:minimumSize 8192,
# well past the default 1024-byte floor; needs a descriptor to run through (reuses #midi-two's: audio in to out,
# the MIDI input fed to nothing, same as #midi-two beside it)
<urn:openmixer:test:host-fixture#midi-rsz>
    a lv2:Plugin ;
    doap:name "openmixer host fixture (MIDI rsz:minimumSize twin)" ;
    lv2:requiredFeature urid:map ;
    lv2:port [
        a lv2:AudioPort , lv2:InputPort ; lv2:index 0 ; lv2:symbol "in" ; lv2:name "In"
    ] , [
        a lv2:AudioPort , lv2:OutputPort ; lv2:index 1 ; lv2:symbol "out" ; lv2:name "Out"
    ] , [
        a atom:AtomPort , lv2:InputPort ; atom:bufferType atom:Sequence ; atom:supports midi:MidiEvent ;
        rsz:minimumSize 8192 ;
        lv2:index 2 ; lv2:symbol "midi_in" ; lv2:name "MIDI In"
    ] .

# the atom twin (#atom-shape, omx-clap-core#3): a main pair and an atom:Sequence input that takes no MIDI, so
# read_ports feeds it an empty sequence and classifies it LV2_ROLE_ATOM_IN, not as the MIDI input (that arm is
# #mixed's); #atom beside it is a non-sequence atom port, refused unfed, so it cannot stand for this shape
<urn:openmixer:test:host-fixture#atom-shape>
    a lv2:Plugin ;
    doap:name "openmixer host fixture (atom twin: a sequence input that takes no MIDI)" ;
    lv2:requiredFeature urid:map ;
    lv2:port [
        a lv2:AudioPort , lv2:InputPort ; lv2:index 0 ; lv2:symbol "in" ; lv2:name "in"
    ] , [
        a lv2:AudioPort , lv2:OutputPort ; lv2:index 1 ; lv2:symbol "out" ; lv2:name "out"
    ] , [
        a atom:AtomPort , lv2:InputPort ; atom:bufferType atom:Sequence ;
        lv2:index 2 ; lv2:symbol "events" ; lv2:name "events"
    ] .
